# Serverdagi sirlar fayli. Odatda uni ./deploy.sh o'zi yaratadi.
# Qo'lda yaratmoqchi bo'lsangiz: cp .env.prod.example .env.prod  va to'ldiring.
# GITGA QO'SHILMAYDI (.gitignore da).

# --- Majburiy ---
DOMAIN=api.misol.uz
#   python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=
POSTGRES_USER=pdpjunior
POSTGRES_DB=pdpjunior
# Faqat harf va raqam (u DATABASE_URL ichiga qo'yiladi): openssl rand -hex 24
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# --- Tarmoq ---
CORS_ALLOWED_ORIGINS=https://pdp-junior-test.netlify.app
TRUSTED_PROXY_COUNT=1

# --- Celery (ixtiyoriy) ---
CELERY_ENABLED=0
CELERY_CONCURRENCY=4

# --- Cloudflare R2 (media uchun; bo'lmasa fayllar docker volume'da saqlanadi) ---
