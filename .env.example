# =====================================================================
# PDP Junior Backend — muhit o'zgaruvchilari
# Productionda kamida MAJBURIY bo'limi to'ldirilishi shart.
# =====================================================================

# --------------------------- MAJBURIY --------------------------------
# Django imzo kaliti. Yo'q bo'lsa DEBUG=0 holatida server ishga tushmaydi.
#   python -c "import secrets;print(secrets.token_urlsafe(64))"
SECRET_KEY=

# 0 = production (majburiy), 1 = lokal ishlab chiqish.
# DEBUG=1 holatida Django har bir SQL so'rovni xotirada saqlaydi —
# productionda bu sekin-asta xotirani to'ldiradi.
DEBUG=0

# Vergul bilan: ALLOWED_HOSTS=api.pdp.uz,pdp-junior.onrender.com
ALLOWED_HOSTS=

# Postgres ulanishi (yo'q bo'lsa sqlite ishlatiladi — faqat lokal uchun).
DATABASE_URL=

# --------------------------- REDIS -----------------------------------
# Kesh, rate limiting va Celery shu URL orqali ishlaydi.
# Bo'lmasa: kesh har worker'da alohida bo'ladi (noto'g'ri natijalar),
# rate limiting ishonchsiz bo'ladi, Celery o'chadi.
REDIS_URL=redis://default:parol@host:6379/0
# Kesh uchun alohida DB raqami (default: REDIS_URL ning /1 varianti)
# REDIS_CACHE_URL=
REDIS_CACHE_ENABLED=1
REDIS_MAX_CONNECTIONS=50

# --------------------------- CELERY ----------------------------------
CELERY_ENABLED=1
# CELERY_BROKER_URL=          # default: REDIS_URL
# CELERY_RESULT_BACKEND=      # default: broker
CELERY_CONCURRENCY=4
CELERY_TASK_TIME_LIMIT=300
CELERY_TASK_SOFT_TIME_LIMIT=240

# --------------------------- GUNICORN --------------------------------
# Parallel ishlov beruvchi = GUNICORN_WORKERS x GUNICORN_THREADS.
# Postgres max_connections shundan katta bo'lishi kerak!
GUNICORN_WORKERS=3
GUNICORN_THREADS=8
GUNICORN_TIMEOUT=45
GUNICORN_KEEPALIVE=15
# Worker'ni necha so'rovdan keyin yangilash (0 = hech qachon).
# Har yangilanish ochiq keep-alive ulanishlarni uzadi.
GUNICORN_MAX_REQUESTS=10000

# --------------------------- BAZA ------------------------------------
# Ulanishni necha soniya qayta ishlatish. Katta qiymat tezroq, lekin
# ko'proq ochiq ulanish talab qiladi.
DB_CONN_MAX_AGE=120
DB_SSL_REQUIRE=1
# Bitta SQL so'rov uchun maksimal vaqt (ms) — sekin so'rov worker'ni
# ushlab turmasligi uchun.
DB_STATEMENT_TIMEOUT_MS=15000
DB_CONNECT_TIMEOUT=10

# --------------------------- RATE LIMIT ------------------------------
THROTTLE_ENABLED=1
THROTTLE_ANON=90/min
THROTTLE_USER=600/min
THROTTLE_AUTH=10/min
THROTTLE_SMS=4/min
THROTTLE_PASSWORD=6/min
THROTTLE_TEST_WRITE=180/min
THROTTLE_SHOP_WRITE=20/min
THROTTLE_SYNC=20/min

# --------------------------- KESH TTL (soniya) -----------------------
CACHE_TTL_PUBLIC=300
CACHE_TTL_RANKING=120
CACHE_TTL_HEROES=300
CACHE_TTL_GALLERY=300
CACHE_TTL_SHOP=120
CACHE_TTL_PROGRESS=900

# --------------------------- TASHQI PDP API --------------------------
# Tashqi servis javob bermasa so'rov shu vaqtdan keyin uziladi.
PDP_API_TIMEOUT=8
# Bitta o'quvchi ma'lumoti kamida shu oraliqda bir marta sinxronlanadi.
PDP_SYNC_MIN_INTERVAL=300
# 1 = sinxronizatsiya fon rejimida (Celery), so'rovni bloklamaydi.
PDP_SYNC_ASYNC=1

# --------------------------- API -------------------------------------
API_PAGE_SIZE=50
# Qo'shimcha frontend originlari (vergul bilan)
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# --------------------------- JWT -------------------------------------
JWT_ACCESS_MINUTES=120
JWT_REFRESH_DAYS=30

# --------------------------- LOG -------------------------------------
LOG_LEVEL=INFO
# SQL so'rovlarni ko'rish uchun: DEBUG (faqat vaqtincha!)
SQL_LOG_LEVEL=WARNING

# --------------------------- XAVFSIZLIK ------------------------------
SECURE_SSL_REDIRECT=1
SECURE_HSTS_SECONDS=31536000

# --------------------------- INTEGRATSIYALAR -------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_SHOP_CHAT_ID=
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_SENDER=

# --------------------------- CLOUDFLARE R2 ---------------------------
USE_R2=1
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=pdp-junior-backend
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_LOCATION=media
# Bucket Settings > Public access > R2.dev subdomain
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev
